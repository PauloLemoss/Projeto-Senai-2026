# String de conexão com o Postgres subido pelo docker-compose.yml da raiz
# (usuário/senha/porta devem bater com o .env da raiz)
DATABASE_URL=postgresql+psycopg://mercado:mercado@localhost:5433/mercado_jogadores

# Origem exata do frontend liberada no CORS (nunca "*")
CORS_ORIGIN=http://localhost:5173
